{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dioptra",
  "version": "../package.json",
  "identifier": "org.ghostdev.dioptra",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dioptra",
        "width": 540,
        "height": 920,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ghost-o7",
    "copyright": "Copyright (c) 2026 Ghost-o7",
    "category": "Utility",
    "shortDescription": "Rechner und Datenbank für Augenoptik und Hörakustik",
    "longDescription": "Rechner, Preiskalkulation und Gläserdatenbank für Augenoptik und Hörakustik.",
    "linux": {
      "deb": { "depends": [] }
    },
    "windows": {
      "nsis": { "languages": ["German"], "installMode": "currentUser" }
    }
  }
}
